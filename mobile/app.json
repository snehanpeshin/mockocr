{
  "expo": {
    "name": "Cleanote",
    "slug": "cleanote",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cleanote.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Cleanote uses the camera to scan handwritten notes.",
        "NSPhotoLibraryUsageDescription": "Cleanote uses your photo library to import handwritten notes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cleanote.app",
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6605747981994820~5650365199",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "99179d76-de52-4751-954e-c6b4a3a5f712"
      }
    }
  }
}
